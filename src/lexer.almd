// CSS Syntax Level 3-inspired UTF-8 byte scanner. No source rewriting.
import gramide.tree
import gramide.lex
fn at(s: Bytes, i: Int) -> Int = bytes.get(s, i) ?? -1
fn digit(b: Int) -> Bool = b >= 48 and b <= 57
fn hex(b: Int) -> Bool = digit(b) or (b >= 65 and b <= 70) or (b >= 97 and b <= 102)
fn alpha(b: Int) -> Bool = b == 95 or b >= 128 or (b >= 65 and b <= 90) or (b >= 97 and b <= 122)
fn white(b: Int) -> Bool = list.contains([9, 10, 12, 13, 32], b)
fn same(s: Bytes, i: Int, text: String) -> Bool = {
  let raw = bytes.from_string(text)
  var j = 0
  var yes = true
  while yes and j < bytes.len(raw) { yes = at(s, i + j) == at(raw, j); j = j + 1 }
  yes
}
fn escape_start(s: Bytes, i: Int) -> Bool = at(s, i) == 92 and at(s, i + 1) >= 0 and not list.contains([10, 12, 13], at(s, i + 1))
fn escape_end(s: Bytes, i: Int) -> Int = {
  var j = i + 1
  if hex(at(s, j)) then {
    var n = 0
    while n < 6 and hex(at(s, j)) { j = j + 1; n = n + 1 }
    if white(at(s, j)) then { if at(s, j) == 13 and at(s, j + 1) == 10 then j = j + 2 else j = j + 1 } else ()
  } else {
    // Consume a complete UTF-8 scalar after an escape, not only its lead byte.
    j = j + 1
    while at(s, j) >= 128 and at(s, j) < 192 { j = j + 1 }
  }
  j
}
fn name_start(s: Bytes, i: Int) -> Bool = alpha(at(s, i)) or escape_start(s, i) or (at(s, i) == 45 and (alpha(at(s, i + 1)) or at(s, i + 1) == 45 or escape_start(s, i + 1)))
fn name_end(s: Bytes, i: Int) -> Int = {
  var j = i
  var more = true
  while more {
    if alpha(at(s, j)) or digit(at(s, j)) or at(s, j) == 45 then j = j + 1
    else if escape_start(s, j) then j = escape_end(s, j)
    else more = false
  }
  j
}
fn number_start(s: Bytes, i: Int) -> Bool = digit(at(s, i)) or (at(s, i) == 46 and digit(at(s, i + 1))) or ((at(s, i) == 43 or at(s, i) == 45) and (digit(at(s, i + 1)) or (at(s, i + 1) == 46 and digit(at(s, i + 2)))))
fn number_end(s: Bytes, i: Int) -> Int = {
  var j = i
  if at(s, j) == 43 or at(s, j) == 45 then j = j + 1 else ()
  while digit(at(s, j)) { j = j + 1 }
  if at(s, j) == 46 and digit(at(s, j + 1)) then { j = j + 1; while digit(at(s, j)) { j = j + 1 } } else ()
  if at(s, j) == 101 or at(s, j) == 69 then {
    var k = j + 1
    if at(s, k) == 43 or at(s, k) == 45 then k = k + 1 else ()
    if digit(at(s, k)) then { j = k + 1; while digit(at(s, j)) { j = j + 1 } } else ()
  } else ()
  if name_start(s, j) then j = name_end(s, j) else if at(s, j) == 37 then j = j + 1 else ()
  j
}
fn quoted_end(s: Bytes, i: Int) -> Int = {
  let q = at(s, i)
  var j = i + 1
  var end = -1
  var valid = true
  while j < bytes.len(s) and end < 0 and valid {
    let b = at(s, j)
    if b == q then end = j + 1
    else if b < 32 and b != 9 then valid = false
    else if b == 92 then {
      if at(s, j + 1) == 13 and at(s, j + 2) == 10 then j = j + 3
      else if list.contains([10, 12, 13], at(s, j + 1)) then j = j + 2
      else if escape_start(s, j) then j = escape_end(s, j)
      else valid = false
    } else j = j + 1
  }
  if valid then end else -1
}
fn scan(source: String, recovering: Bool) -> Result[List[tree.Token], lex.LexError] = {
  let s = bytes.from_string(source)
  // gramide 0.2.11 counts source lines by LF. Its multiline-token end
  // calculation treats lone CR differently; reject that unsupported input
  // in strict mode rather than publish inconsistent complete symbol ranges.
  if not recovering then {
    var pos = 0
    var source_line = 1
    var source_start = 0
    while pos < bytes.len(s) {
      guard at(s, pos) != 13 or at(s, pos + 1) == 10 else err(lex.LexError { line: source_line, col: pos - source_start + 1, message: "unsupported lone CR line ending; use LF or CRLF" })
      if at(s, pos) == 10 then { source_line = source_line + 1; source_start = pos + 1 } else ()
      pos = pos + 1
    }
  } else ()
  var tokens: List[tree.Token] = []
  var i = 0
  var line = 1
  var line_start = 0
  while i < bytes.len(s) {
    let start = i
    let first_line = line
    let first_col = i - line_start + 1
    let b = at(s, i)
    var kind = tree.T_NONE
    var message = ""
    if white(b) then i = i + 1
    else if same(s, i, "/*") then {
      i = i + 2
      while i < bytes.len(s) and not same(s, i, "*/") { i = i + 1 }
      if i == bytes.len(s) then message = "unterminated CSS comment" else i = i + 2
    } else if b == 34 or b == 39 then {
      kind = tree.T_STRING
      let end = quoted_end(s, i)
      if end < 0 then { message = "unterminated CSS string, unescaped newline, or unsupported raw control"; i = bytes.len(s) } else i = end
    } else if same(s, i, "<!--") then { kind = tree.T_PUNCT; i = i + 4 }
    else if same(s, i, "-->") then { kind = tree.T_PUNCT; i = i + 3 }
    else if number_start(s, i) then { kind = tree.T_NUMBER; i = number_end(s, i) }
    else if name_start(s, i) then { kind = tree.T_IDENTIFIER; i = name_end(s, i) }
    else if b >= 33 and b <= 126 and b != 92 then { kind = tree.T_PUNCT; i = i + 1 }
    else { message = "unexpected CSS control character or escape"; i = i + 1 }
    if message != "" then {
      guard recovering else err(lex.LexError { line: first_line, col: first_col, message: message })
      kind = tree.T_ERROR
    } else ()
    if kind != tree.T_NONE then list.push(tokens, tree.Token { kind: kind, start: start, end: i, line: first_line, col: first_col }) else ()
    var j = start
    while j < i {
      if at(s, j) == 10 then { line = line + 1; line_start = j + 1 } else ()
      j = j + 1
    }
  }
  list.push(tokens, tree.Token { kind: tree.T_EOF, start: i, end: i, line: line, col: i - line_start + 1 })
  ok(tokens)
}
test "CSS escaped identifiers strings comments dimensions retain bytes" {
  let src = "/* 😀 */ .\\31 0café { --gap: -1.5rem; content: \"/* hi */\"; }"
  let ts = scan(src, false)!
  assert_eq(tree.token_text(bytes.from_string(src), list.get(ts, 1)!), "\\31 0café")
  assert_eq(tree.token_text(bytes.from_string(src), list.get(ts, 5)!), "-1.5rem")
}
test "CSS lexical failures do not silently drop data" {
  for src in ["/*unfinished", "'bad\nstring'", "\\\n"] { assert(result.is_err(scan(src, false))) }
  assert(result.is_ok(scan("'bad\nstring'", true)))
}

test "strict scanners reject lone CR even inside multiline tokens" {
  assert(result.is_err(scan("\r", false)))
  assert(result.is_err(scan("/* \r */", false)))
  assert(result.is_ok(scan("\r\n", false)))
}

test "form feed is CSS whitespace without changing source LF coordinates" {
  let tokens = scan("\u{000c}.name {}", false)!
  assert_eq((list.get(tokens, 0)!).line, 1)
}

test "raw controls in selector strings cannot reach symbols JSON" {
  assert(result.is_err(scan(".x[data='a\u{0001}b'] {}", false)))
}
